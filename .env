# env-manager: apartment-furnishing
# env-manager local: false
# env-manager generate: packages/shared/src/env.ts

# The web plan in development; production serves it from the Worker at SERVER_URL.
UI_URL=http://apartment-furnishing.localhost # {url}
# The Worker: `wrangler dev` on PORT in dev, https://apartment.stf.lol in prod. The runner and the Vite proxy call it.
SERVER_URL=http://127.0.0.1:6161 # {url}
UI_PORT=6160 # {int}
PORT=6161 # {int}
# The one credential for the API: the iOS app and the runner send it as a bearer, a browser signs in with it once.
# Its own random value per environment; `bun run secrets:push` sets prod's on the Worker.
API_TOKEN= # {optional string}
# Deploys and GitHub's deploy secrets. Only prod has them.
CLOUDFLARE_ACCOUNT_ID= # {optional string}
CLOUDFLARE_API_TOKEN= # {optional string}
