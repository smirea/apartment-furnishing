{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "apartment-furnishing",
	"main": "src/worker.ts",
	"compatibility_date": "2026-10-01",
	"routes": [{ "pattern": "apartment.stf.lol", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false,
	// Every request runs the Worker first, so the UI shell sits behind the same sign-in as the API.
	"assets": {
		"directory": "../ui/build",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true,
	},
	// API_TOKEN is a secret, pushed with `bun run secrets:push`.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "apartment-furnishing",
			"database_id": "096e11e4-83ac-47ee-9997-d8d3d3dc7686",
			"migrations_dir": "migrations",
		},
	],
	// Photos, models and textures under items/<id>/, as data/items/ held them on the laptop.
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "apartment-furnishing-assets" }],
	"vars": { "ASSETS_FALLBACK_URL": "", "ASSETS_FALLBACK_TOKEN": "" },
	"observability": { "enabled": true },
}
