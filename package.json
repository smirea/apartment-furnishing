{
	"name": "apartment-furnishing",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"build": "bun --filter @repo/ui build",
		"dev": "concurrently --raw -k -s first \"bun run --cwd apps/server dev\" \"bun run --cwd apps/ui dev --host 127.0.0.1\" \"bun run --cwd apps/runner dev\"",
		"format": "oxfmt --write .",
		"import": "bun scripts/import-item.ts",
		"import-textures": "bun scripts/import-textures.ts",
		"ios": "bun app-ios/scripts/run",
		"lint": "oxlint --fix && oxfmt --write .",
		"lint:ci": "oxlint && oxfmt --check .",
		"env:generate": "env-manager gen --local",
		"postinstall": "lefthook install",
		"server:dev": "bun --filter @repo/server dev",
		"server:typecheck": "bun --filter @repo/server typecheck",
		"test": "bun test --pass-with-no-tests",
		"typecheck": "bun --filter @repo/ui check && bun --filter @repo/server typecheck && bun --filter @repo/runner typecheck",
		"ui:build": "bun --filter @repo/ui build",
		"ui:check": "bun --filter @repo/ui check",
		"ui:dev": "bun --filter @repo/ui dev --host 127.0.0.1",
		"ui:preview": "bun --filter @repo/ui preview",
		"worktree:setup": "bun scripts/seed-db.ts",
		"deploy": "bun run build && bun --filter @repo/server deploy",
		"runner": "bun --filter @repo/runner start",
		"runner:prod": "bun scripts/runner-prod.ts",
		"secrets:push": "bun scripts/secrets.ts push",
		"secrets:github": "bun scripts/secrets.ts github",
		"secrets:check": "bun scripts/secrets.ts check",
		"env:ios": "bun scripts/secrets.ts ios"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.5",
		"@typescript/native": "npm:typescript@^7.0.2",
		"concurrently": "^10.0.6",
		"env-manager": "github:smirea/env-manager#3d16babe8e4d11d3f131b0f8af8497bc0b8b7180",
		"lefthook": "^2.2.1",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"typescript": "^6.0.3"
	},
	"packageManager": "bun@1.4.4"
}
